<form action="/submit" method="POST">
  <input
    type="text"
    name="name"
    placeholder="Student Name"
    required
  /><br /><br />
  <input
    type="number"
    name="t1"
    placeholder="T1 (out of 25)"
    max="25"
    required
  /><br />
  <input
    type="number"
    name="t2"
    placeholder="T2 (out of 25)"
    max="25"
    required
  /><br />
  <input
    type="number"
    name="t3"
    placeholder="T3 (out of 25)"
    max="25"
    required
  /><br />
  <input
    type="number"
    name="t4"
    placeholder="T4 (out of 25)"
    max="25"
    required
  /><br /><br />
  <button type="submit">Generate Result</button>
</form>
